{
  "name": "amrita-connect",
  "version": "1.0.0",
  "description": "Amrita Connect (CECMS) - College Event and Club Management System",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "node backend/src/server.js",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "db:setup": "npm run db:setup --prefix backend",
    "db:seed-accounts": "npm run db:seed-accounts --prefix backend",
    "test": "npm run test --prefix backend"
  },
  "engines": {
    "node": ">=18"
  }
}
