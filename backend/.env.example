# ---------------------------------------------------------------------------
# Amrita Connect backend configuration.  Copy to ".env" and fill in.
# NEVER commit the real .env file.  No value below is a real secret.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Browser origin(s) of the React app (comma separated)
CLIENT_ORIGIN=http://localhost:5173
# Set to true when running behind a reverse proxy (needed for correct client IPs)
TRUST_PROXY=false

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=amrita_connect

# ---- Auth (REQUIRED) ----
# Random string, 32+ chars.  Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional extra secret used to HMAC OTP codes (defaults to a value derived from JWT_SECRET)
OTP_PEPPER=
SESSION_HOURS=8
BCRYPT_ROUNDS=12

# ---- OTP policy ----
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=5
OTP_MAX_PER_DESTINATION_PER_HOUR=8

# Approved student e-mail domain(s) used until an Admin changes them in the dashboard
STUDENT_EMAIL_DOMAINS=cb.students.amrita.edu

# ---- Email delivery (student OTP + notifications) ----
# EMAIL_PROVIDER = none | smtp | graph
EMAIL_PROVIDER=none
EMAIL_FROM="Amrita Connect <no-reply@your-domain.example>"
# SMTP (works with Microsoft 365 / Outlook SMTP: smtp.office365.com, 587, SMTP AUTH enabled for the mailbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Microsoft Graph (Azure AD app registration with Mail.Send application permission)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_USER=

# ---- SMS delivery (coordinator/admin OTP) ----
# SMS_PROVIDER = none | twilio
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# ---- Development helper (ignored/refused when NODE_ENV=production) ----
# If true AND no provider is configured, OTP codes are printed in THIS SERVER'S CONSOLE.
# They are NOT delivered to the user. Leave false to see honest "delivery not configured" errors.
DEV_LOG_OTP_TO_CONSOLE=false

# ---- Rate limiting / scheduler ----
RATE_LIMIT_GENERAL=600
RATE_LIMIT_AUTH=40
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# ---- Used only by `npm run db:seed-accounts` ----
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=Platform Admin
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=
SEED_COORDINATOR_EMAIL=
SEED_COORDINATOR_NAME=Demo Coordinator
SEED_COORDINATOR_PHONE=
SEED_COORDINATOR_PASSWORD=
