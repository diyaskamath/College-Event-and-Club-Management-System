{
  "name": "amrita-connect-backend",
  "version": "1.0.0",
  "description": "Amrita Connect (CECMS) REST API - Express + MySQL",
  "main": "src/server.js",
  "private": true,
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node scripts/setup-db.js",
    "db:seed-accounts": "node scripts/seed-accounts.js",
    "test": "node --test --test-concurrency=1 tests/api.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "nodemailer": "^6.9.14",
    "zod": "^3.23.8"
  }
}
